#!/bin/bash
# Post-checkout hook: runs after git checkout or clone
# Automatically sets up binaries and models

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Only run if setup hasn't been done yet
if [ ! -f "$SCRIPT_DIR/llama.cpp/bin/llama-cli" ] && [ ! -f "$SCRIPT_DIR/whisper.cpp/bin/main" ]; then
    echo -e "${BLUE}Setting up binaries after clone/checkout...${NC}"
    
    cd "$SCRIPT_DIR"
    
    # Run setup if it exists
    if [ -f "setup.sh" ]; then
        bash setup.sh || {
            echo -e "${YELLOW}Warning: Binary setup had issues. You may need to run ./setup.sh manually${NC}"
        }
    fi
fi
